# ---------------------------------------------------------------------------
# Noesis — Configuración de entorno (copiar a .env y completar)
# ---------------------------------------------------------------------------

# --- Modelo Mistral ---------------------------------------------------------
# Obtén una API key en https://console.mistral.ai
# Si se deja vacío, el backend usa un modo "extractivo" de respaldo (sin LLM).
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# --- Proveedor de embeddings ------------------------------------------------
# Opciones: "sentence_transformers" (local, open source) | "mistral" | "hash" (offline/pruebas)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Dimensión usada solo por el proveedor "hash"
EMBEDDING_DIM=384

# --- Base vectorial (Qdrant) ------------------------------------------------
# Para docker-compose se inyecta automáticamente QDRANT_URL=http://qdrant:6333
# Deja QDRANT_URL vacío para usar Qdrant embebido en memoria (solo desarrollo/pruebas).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=noesis_chunks

# --- Almacenamiento de metadatos -------------------------------------------
DATABASE_URL=sqlite:///./data/noesis.db
UPLOAD_DIR=./data/uploads

# --- Parámetros RAG ---------------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RAG_TOP_K=5

# --- API --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
DEFAULT_INSTITUTION_ID=default
DEFAULT_INSTITUTION_NAME=Institución Demo
